% Font (automatically uses old-style figures)
\usepackage[semibold]{ebgaramond}
\usepackage[latin,english]{babel}

\usepackage{textcomp} % This is for the --- in section titles

\usepackage{xhfill}

\usepackage{graphicx}

\usepackage{tabularx}
\renewcommand{\arraystretch}{1.33}

% This restyles titles, e.g. to remove numbers, centre them, etc.
\usepackage{titlesec}
\newcommand{\formatsection}[1]{\xrfill[0.5ex]{0.4pt}\hspace{0.5cm}\MakeLowercase{#1}\hspace{0.5cm}\xrfill[0.5ex]{0.4pt}}
\titleformat{\section}[block] {\LARGE\scshape} {} {0em} {\formatsection}
\newcommand{\formatsubsection}[1]{\xrfill[0.5ex]{0.4pt}[gregoriocolor]\hspace{0.5cm}{\large\scshape\centering\GreColored{#1}}\hspace{0.5cm}\xrfill[0.5ex]{0.4pt}[gregoriocolor]}
\titleformat{\subsection} {} {} {0em} { \formatsubsection }
\titleformat{\subsubsection} {} {} {0em} { \bfseries\scshape\centering\GreColored }

\newcommand{\sectionlinetwo}[1]{\vspace{-0.25cm}
\begin{center}
\large\itshape{#1}
\end{center}
}
\newcommand{\bisection}[2]{\section{#1}
  \sectionlinetwo{#2}
  \vspace{-0.50cm}
}

\newcommand{\subsectionlinetwo}[1]{\vspace{-0.15cm}
\begin{center}
\itshape\GreColored{#1}
\end{center}
}
\newcommand{\bisubsection}[2]{\subsection{#1}
  \subsectionlinetwo{#2}
  \vspace{-0.25cm}
}
\newcommand{\bisubsectionnoline}[2]{
  \titleformat{\subsection} {} {} {0em} { \large\scshape\centering\GreColored }
  \subsection{#1}
  \titleformat{\subsection} {} {} {0em} { \formatsubsection }
  \subsectionlinetwo{#2}
  \vspace{-0.25cm}
}

\newcommand{\readingtitle}[1]{\vspace{-0.30cm}
\begin{center}
{\linespread{0.8}
\large\itshape{#1}
}
\end{center}
\vspace{-0.20cm}
}

\newcommand{\redlineseparator}{
\begin{center}
  \GreColored{\rule{0.2\linewidth}{0.4pt}}
\end{center}
}


% Restyle title, e.g. to change spacing above and below, make small caps, etc.
\usepackage{titling}
\posttitle{\par\end{center}}
\setlength{\droptitle}{-3em}
\let\oldtitle\title
\renewcommand{\title}[1]{\oldtitle{\textls[90]{\MakeLowercase{\textsc{#1}}}}}

% Add bookmarks in the pdf
\usepackage[bookmarks, hidelinks]{hyperref}
\usepackage[depth=section]{bookmark}

% This makes punctuation overhang a little (it looks good)
\usepackage{microtype}
