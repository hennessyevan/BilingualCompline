% ----------------------------------bireading-----------------------------------
 
\newcommand{\bireading}[2]{
\setlength{\columnsep}{\saveparindent}
\columnratio{\columnratiotext}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
#1
\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
#2
\end{rightcolumn}
\end{paracol}
}

% ----------------------------------bisentence-----------------------------------
 
\newcommand{\bisentence}[2]{
\setlength{\columnsep}{\saveparindent}
\columnratio{\columnratiotext}
% \twosided
\vspace{-0.15cm}
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\center
\itshape
\GreColored{#1}
\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
\center
\itshape
\GreColored{#2}
\end{rightcolumn}
\end{paracol}
}

% -------------------------------biinstruction----------------------------------
 
\newcommand{\biinstruction}[2]{
  \bireading{\itshape\GreColored{#1}}{\itshape\GreColored{#2}}
}

% -------------------------------bisaidantiphon----------------------------------
 
\newcommand{\bisaidantiphon}[2]{
  \bireading{\noindent\itshape{#1}}{\noindent\itshape{#2}}
}

% ---------------------------------chantlabel-----------------------------------
 
% Give a little heading, e.g. for the occasion (In memoriis, in festic, etc)
\newcommand{\chantlabel}[1]{
\vspace{0.20cm}
\noindent{\textit{\GreColored{#1}}}
\vspace{-0.10cm}
}

% -------------------------------chantlabelenglish------------------------------
 
\newcommand{\chantlabelenglish}[1]{
\chantlabel{\small#1}
}

% --------------------------------bimusicequal----------------------------------
 
\NewDocumentCommand\bimusicequal{o o +m +m}{
\setlength{\columnsep}{\saveparindent}
\columnratio{\columnratiotext}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\IfValueT{#1}{\chantlabel{#1}

}
  #3
\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
\IfValueT{#2}{\chantlabelenglish{#2}

}
  #4
\end{rightcolumn}
\end{paracol}
}

% ---------------------------------bimusic--------------------------------------
 
\NewDocumentCommand\bimusic{o o +m +m}{
\setlength{\columnsep}{1.0em}
\columnratio{\columnratiomusic}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\IfValueT{#1}{\chantlabel{#1}

}
  #3
\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
\IfValueT{#2}{\chantlabelenglish{#2}

}
{\vspace{\musiclyricsspace}\small\itshape\parindent0pt#4}
\end{rightcolumn}
\end{paracol}
}

% ------------------------------bimusichangingdouble----------------------------
 
\NewDocumentCommand\bimusichangingdouble{o o +m +m}{
\setlength{\columnsep}{1.0em}
\columnratio{\columnratiomusic}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\IfValueT{#1}{\chantlabel{#1}

}
#3

\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
\IfValueT{#2}{\chantlabelenglish{#2}

}
\vspace{\musiclyricsspace}
\begin{hangingdouble}
{\small\itshape#4

}
\end{hangingdouble}
\end{rightcolumn}
\end{paracol}
}

% ---------------------------bimusichangingdoubleversicle-----------------------

% This is so that the initial letter is not big (it is 
% a VBar (V/). This must be restored to its default (1).
\NewDocumentCommand\bimusichangingdoubleversicle{o o +m +m}{
\setlength{\columnsep}{1.0em}
\columnratio{\columnratiomusic}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\IfValueT{#1}{\chantlabel{#1}

}
  \gresetinitiallines{0}#3\gresetinitiallines{1}
\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
\IfValueT{#2}{\chantlabelenglish{#2}

}
\vspace{\musiclyricsspace}
\begin{hangingdoubleversicle}
  {\small\itshape#4}
\end{hangingdoubleversicle}
\end{rightcolumn}
\end{paracol}
}

% --------------------------------firstlinetranslation--------------------------
 
% Give the first line translation for a hymn
\newcommand{\firstlinetranslation}[1]{
  \vspace{0.25cm}
  \textit{\centering #1\\}
  \vspace{0.10cm}
}

