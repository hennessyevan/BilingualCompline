\usepackage{HangingStyles}

\usepackage{xparse}
\usepackage{multicol}
\usepackage{setspace}

\newlength{\musiclyricsspace}
\setlength\musiclyricsspace{0.70em}

\usepackage{paracol}
\newcommand\columnratiotext{0.5}
\newcommand\columnratiomusic{0.72}

% -----------------------------bihangingtriple----------------------------------
 
\newcommand{\bihangingtriple}[2]{
\setlength{\columnsep}{\saveparindent}
\columnratio{\columnratiotext}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\begin{hangingtriple}
#1
\end{hangingtriple}
\end{leftcolumn}

\begin{rightcolumn}
\begin{hangingtriple}
\textit{#2}
\end{hangingtriple}
\end{rightcolumn}
\end{paracol}
}

% -----------------------------bihangingpsalm-----------------------------------
 
\newcommand{\bihangingpsalm}[2]{
\setlength{\columnsep}{\saveparindent}
\columnratio{\columnratiotext}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\begin{hangingpsalm}
#1
\end{hangingpsalm}
\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
\begin{hangingpsalm}
#2
\end{hangingpsalm}
\end{rightcolumn}
\end{paracol}
}

% -------------------------------bihangingtripleversicle------------------------
 
\newcommand{\bihangingtripleversicle}[2]{
\setlength{\columnsep}{\saveparindent}
\columnratio{\columnratiotext}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\begin{hangingtripleversicle}
#1
