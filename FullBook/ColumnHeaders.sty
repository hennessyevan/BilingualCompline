% -------------------------------quadhangingdouble----------------------------
 
% Four column layout for hymn verses when there are multiple settings, e.g.
% Te lucis ante terminum for compline
\newcommand{\quadhangingdouble}[4]{
\vspace{-0.50cm}
\setlength{\columnsep}{\saveparindent}
\columnratio{\columnratiotext}
% \twosided
\begin{paracol}{2}
\begin{leftcolumn}
\selectlanguage{latin}
\begin{multicols}{2}
\begin{hangingdouble}
#1

\columnbreak % This command is used for breaking columns in a predictable manner.
#2

\end{hangingdouble}
\end{multicols}
\end{leftcolumn}

\begin{rightcolumn}
\selectlanguage{english}
\begin{multicols}{2}
\begin{hangingdouble}
{\small\setstretch{1.10}
\textit{#3}

\columnbreak % This command is used for breaking columns in a predictable manner.
\textit{#4}

}
\end{hangingdouble}
\end{multicols}
\end{rightcolumn}
\end{paracol}
\vspace{-0.75cm}
}
